    },
    "mixer.automation.forGroup": {
      "comment": "The line under a VCA group. %@ is the whole automation line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (for every strip in the group)"
          }
        }
      }
    },
    "mixer.automation.level": {
      "comment": "Under a strip in the mixer. %1$@ is the count of points (\"4 points\"), %2$@ the span of the lane (\"−12.0 dB to +0.0 dB\").",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on the level, %2$@, added to the fader"
          }
        }
      }
    },
    "mixer.automation.line": {
      "comment": "The whole line under a strip. %@ is the lanes' descriptions joined by the separator below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation: %@"
          }
        }
      }
    },
    "mixer.automation.mute": {
      "comment": "Under a strip in the mixer. %@ is the count of points.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on the mute"
          }
        }
      }
    },
    "mixer.automation.off": {
      "comment": "Added after a lane's description when the lane is switched off. Begins with a space.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (switched off)"
          }
        }
      }
    },
    "mixer.automation.pan": {
      "comment": "Under a strip in the mixer. %@ is the count of points.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on the pan, in the slider's place"
          }
        }
      }
    },
    "mixer.automation.points": {
      "comment": "A count of automation points. Used inside the lines below as the first part.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld point"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld points"
                }
              }
            }
          }
        }
      }
    },
    "mixer.automation.send": {
      "comment": "Under a strip in the mixer. %@ is the count of points.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on a send"
          }
        }
      }
    },
    "mixer.automation.separator": {
      "comment": "Between two lanes' descriptions in one line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "; "
          }
        }
      }
    },
    "mixer.automation.span": {
      "comment": "The lowest and highest value of a lane, each a level like \"−12.0 dB\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to %2$@"
          }
        }
      }
    },
    "mixer.heard.groupAutomated": {
      "comment": "A member strip's line when its group has automation. %@ is the sentence about what is heard with the group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, and the group's automation on top"
          }
        }
      }
    },
    "mixer.pan.automated": {
      "comment": "Beside a strip’s pan slider when a pan lane steers the pan. Short: 72 points wide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automated"
          }
        }
      }
    },
    "mixer.pan.automated.help": {
      "comment": "Why the pan slider is grey.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pan lane steers this strip’s pan, so the slider does nothing. Switch the lane off or clear it to pan by hand."
          }
        }
      }
    },
    "paid.settings.about": {
      "comment": "Settings › Paid Services.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before a request that costs money, Jämmer shows the price and asks. Where it doesn’t know the price, it asks once for each service whether to go on without one, and says that the price is unknown every time after that. Those answers are kept here."
          }
        }
      }
    },
    "paid.settings.none": {
      "comment": "Settings › Paid Services, the empty list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No service has been allowed without a known price."
          }
        }
      }
    },
    "paid.settings.row": {
      "comment": "A row in Settings › Paid Services. %@ is the service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: used without a known price"
          }
        }
      }
    },
    "paid.settings.tab": {
      "comment": "A tab in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid Services"
          }
        }
      }
    },
    "paid.settings.takeBack": {
      "comment": "The button that takes back the answer for a service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Again"
          }
        }
      }
    },
    "paid.unknownPrice.accepted": {
      "comment": "Shown in place of the box once it has been ticked for the service. %@ is the service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämmer doesn’t know the price of this. You have said that %@ may be used all the same; take that back in Settings › Paid Services."
          }
        }
      }
    },
    "paid.unknownPrice.tick": {
      "comment": "The box that must be ticked before a paid request with no known price. %@ is the service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämmer doesn’t know the price. Use %@ anyway"
          }
        }
      }
    }
  },
  "version": "1.0"
}