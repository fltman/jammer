    "paid.settings.about": {
      "comment": "Settings › Paid Services.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before a request that costs money, Jämmer shows the price and asks. Where it doesn’t know the price, it asks once for each service whether to go on without one, and says that the price is unknown every time after that. Those answers are kept here."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Före en förfrågan som kostar pengar visar Jämmer priset och frågar. Där den inte vet priset frågar den en gång per tjänst om den ska fortsätta utan, och säger varje gång därefter att priset är okänt. De svaren sparas här."
          }
        }
      }
    },
    "paid.settings.none": {
      "comment": "Settings › Paid Services, the empty list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
