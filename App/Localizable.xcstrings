    "link.waiting.about": {
      "comment": "The top of the Linked Files Waiting window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work on files another app handed over, kept for later and not yet saved back. Jämmer also opens these by itself when it starts, and when the same file is handed over again."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbete på filer som en annan app lämnade över, behållet till senare och inte tillbakasparat än. Jämmer öppnar dem också själv när det startar, och när samma fil lämnas över igen."
          }
        }
      }
    },
    "link.waiting.broken": {
      "comment": "Above the path of a journal file that can’t be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A record that can’t be read. Jämmer has left it as it is:"
          }
        },
        "sv": {
