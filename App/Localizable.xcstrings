{
  "sourceLanguage": "en",
  "strings": {
    "automation.ax.group": {
      "comment": "VoiceOver: the group of lanes in the timeline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation"
          }
        }
      }
    },
    "automation.ax.group.strips": {
      "comment": "VoiceOver: the group of lane rows under the tracks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation of buses, groups and the master"
          }
        }
      }
    },
    "automation.ax.inView": {
      "comment": "How many of a lane’s points are in the part of the timeline that is shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld in view"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld in view"
                }
              }
            }
          }
        }
      }
    },
    "automation.ax.lane.gain": {
      "comment": "VoiceOver: a lane. %@ is the track.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level automation of %@"
          }
        }
      }
    },
    "automation.ax.lane.mute": {
      "comment": "VoiceOver: a lane. %@ is the track.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute automation of %@"
          }
        }
      }
    },
    "automation.ax.lane.pan": {
      "comment": "VoiceOver: a lane. %@ is the track.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan automation of %@"
          }
        }
      }
    },
    "automation.ax.lane.role": {
      "comment": "VoiceOver: what kind of thing a lane is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "automation lane"
          }
        }
      }
    },
    "automation.ax.point": {
      "comment": "VoiceOver: a point’s name. Both are whole numbers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point %1$@ of %2$@"
          }
        }
      }
    },
    "automation.ax.point.role": {
      "comment": "VoiceOver: what kind of thing a point is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "automation point"
          }
        }
      }
    },
    "automation.ax.point.value": {
      "comment": "VoiceOver: a point’s value. %1$@ is its time, %2$@ its value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "automation.ax.points": {
      "comment": "How many points a lane has.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld point"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld points"
                }
              }
            }
          }
        }
      }
    },
    "automation.caption.empty": {
      "comment": "Caption on the focused track when it has no lane of the shown kind.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lane yet. ⌥-click or ⌥Return adds a point"
          }
        }
      }
    },
    "automation.caption.level": {
      "comment": "Caption of a lane in the timeline. %@ is the fader’s level.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level lane, added to the fader (%@)"
          }
        }
      }
    },
    "automation.caption.level.groupOnly": {
      "comment": "Caption on a track that has no lane of its own. %1$@ is its VCA group, %2$@ the fader’s level with the group’s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level lane of %1$@, added to the fader (%2$@)"
          }
        }
      }
    },
    "automation.caption.level.withGroup": {
      "comment": "Caption. %1$@ is a VCA group, %2$@ the fader’s level with the group’s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level lane with the lane of %1$@ in it, added to the fader (%2$@)"
          }
        }
      }
    },
    "automation.caption.mute": {
      "comment": "Caption of a mute lane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute lane"
          }
        }
      }
    },
    "automation.caption.mute.groupOnly": {
      "comment": "Caption on a track with no mute lane of its own. %@ is its VCA group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute lane of %@"
          }
        }
      }
    },
    "automation.caption.mute.withGroup": {
      "comment": "Caption. %@ is a VCA group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute lane with the lane of %@ in it"
          }
        }
      }
    },
    "automation.caption.off": {
      "comment": "A lane that is kept but not played. %@ is the lane’s caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: switched off, not heard"
          }
        }
      }
    },
    "automation.caption.pan": {
      "comment": "Caption of a pan lane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan lane, in place of the pan slider. Left is up."
          }
        }
      }
    },
    "automation.focus.status": {
      "comment": "Status line when the focus moves to another track’s lane. %@ is the track.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation: the lane of %@"
          }
        }
      }
    },
    "automation.label": {
      "comment": "The label at the pointer: the time and the value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@  %2$@"
          }
        }
      }
    },
    "automation.label.heard": {
      "comment": "The label at the pointer on a level lane: time, the lane’s value, and what is heard with the group’s lane and the fader.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@  %2$@ (heard %3$@)"
          }
        }
      }
    },
    "automation.point.removed": {
      "comment": "Status line. %@ is \"3 points\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point removed; %@ left"
          }
        }
      }
    },
    "automation.point.status": {
      "comment": "Status line and VoiceOver when a point is selected, added or moved. Two whole numbers, the time, the value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point %1$@ of %2$@: %3$@, %4$@"
          }
        }
      }
    },
    "automation.points.moved": {
      "comment": "Status line: several points were moved together.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld point moved"
