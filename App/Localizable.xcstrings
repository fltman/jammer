        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till plugin"
          }
        }
      }
    },
    "plugins.died": {
      "comment": "Status line when a plugin’s helper process died. %1$@ is the plugin, %2$@ how it died, in the plugin host’s own English words (for example “crashed”).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ and was switched off. Tracks that use it play without it; the document is untouched. Switch it on again in Audio › Plugins…."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ och stängdes av. Spår som använder den spelar utan den; dokumentet är orört. Slå på den igen under Ljud › Pluginer…."
          }
        }
      }
    },
