    "access.ask.files": {
      "comment": "Part of access.ask.text: how many files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld audio file"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld audio files"
                }
              }
            }
          }
        }
      }
    },
    "access.ask.folders": {
      "comment": "Part of access.ask.text: from how many folders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld other folder"
