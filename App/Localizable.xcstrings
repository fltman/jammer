                  "state": "translated",
                  "value": "Läste in projektets inställningar i %lld pluginer."
                }
              }
            }
          }
        }
      }
    },
    "pluginSettings.notStarted.many": {
      "comment": "Status line. %@ is how many plugins (two or more).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plugins weren’t started: the project’s settings for them weren’t loaded."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pluginer startades inte: projektets inställningar för dem lästes inte in."
          }
        }
      }
    },
    "pluginSettings.notStarted.one": {
      "comment": "Status line. %@ is the plugin.",
      "extractionState": "manual",
      "localizations": {
