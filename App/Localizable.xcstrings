    "transcript.engine.openai.help": {
      "comment": "Tooltip of the OpenAI choice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio is uploaded to OpenAI and transcribed there, for a price. The text comes back without the time of each word: you can read, search and correct it, but not edit the audio with it. Built from OpenAI’s documentation, not tried with a real request."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet laddas upp till OpenAI och transkriberas där, mot betalning. Texten kommer tillbaka utan tiden för varje ord: du kan läsa, söka i och rätta den, men inte redigera ljudet med den. Byggd efter OpenAI:s dokumentation, inte provad med en riktig förfrågan."
          }
        }
      }
    },
