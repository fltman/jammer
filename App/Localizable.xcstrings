        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made by Jämmer and last used by a project that can’t be read just now (on another disk, or moved). They can be chosen once that project has been opened again."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjorda av Jämmer och senast använda av ett projekt som inte går att läsa just nu (på en annan disk, eller flyttat). De kan väljas när det projektet har öppnats igen."
          }
        }
      }
    },
    "storage.intro": {
      "comment": "Explanation at the top of the storage window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effects, repairs and frozen tracks are made as new audio files in Jämmer’s media folder; your own files are never changed. This shows what is there. Nothing is removed unless you choose it here, and what you choose goes to the Trash."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Effekter, reparationer och frysta spår görs som nya ljudfiler i Jämmers mediamapp; dina egna filer ändras aldrig. Här syns vad som finns där. Inget tas bort om du inte väljer det här, och det du väljer hamnar i papperskorgen."
          }
        }
      }
    },
