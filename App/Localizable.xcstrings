            "state": "translated",
            "value": "No service has been allowed without a known price."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tjänst har tillåtits utan känt pris."
          }
        }
      }
    },
    "paid.settings.row": {
