    "plugins.failed.blocked": {
      "comment": "A line about a plugin. %@ is the plugin.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is switched off: it failed while it was in use."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är avstängd: den misslyckades medan den användes."
          }
        }
      }
    },
    "plugins.failed.kept": {
      "comment": "A line about a plugin. %1$@ the plugin, %2$@ why, as a short clause (plugins.failed.why.…) or the scanner’s own code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is still listed from an earlier scan; the last scan of it didn’t succeed (%2$@). It will be tried again."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ står kvar från en tidigare sökning; den senaste sökningen av den lyckades inte (%2$@). Den provas igen."
          }
        }
      }
    },
    "plugins.failed.noAnswer": {
      "comment": "A line about a plugin. %@ is the plugin.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn’t be scanned (the scanner got no answer). It will be tried again at the next scan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunde inte sökas igenom (sökningen fick inget svar). Den provas igen vid nästa sökning."
          }
        }
      }
    },
    "plugins.failed.other": {
      "comment": "A line about a plugin. %1$@ the plugin, %2$@ the scanner’s own reason code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ couldn’t be used (%2$@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kunde inte användas (%2$@)."
          }
        }
      }
    },
    "plugins.failed.timedOut": {
      "comment": "A line about a plugin. %@ is the plugin. Names the button Scan for CLAP Plugins.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t answer in time when it was scanned. A plugin that keeps doing that is tried again only now and then, so it doesn’t hold up every start; Scan for CLAP Plugins tries it at once."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarade inte i tid när den söktes igenom. En plugin som fortsätter med det provas bara då och då, så att den inte håller upp varje start; Sök efter CLAP-pluginer provar den genast."
          }
        }
      }
    },
    "plugins.failed.why.noAnswer": {
      "comment": "A reason inside the parentheses of plugins.failed.kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the scanner got no answer"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "sökningen fick inget svar"
          }
        }
      }
    },
    "plugins.failed.why.timedOut": {
