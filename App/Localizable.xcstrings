    },
    "mixer.intro": {
      "comment": "Explanation at the top of the mixer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks go to the output, or to a bus that gathers several of them under one level. A document without buses, with every pan in the center, plays exactly as it always did."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spår går till utgången, eller till en buss som samlar flera under en nivå. Ett dokument utan bussar, med all panorering i mitten, spelar precis som det alltid har gjort."
          }
        }
      }
    },
    "mixer.level.ax": {
