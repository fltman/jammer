    "import.outside.text": {
      "comment": "Alert text. %1$@ the timeline file, %2$@ “3 audio files”, %3$@ the list of files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” names %2$@ outside its own folder:\n\n%3$@\n\nIf the timeline is your own, or you trust where it came from, use them. Otherwise import without: those clips are left out, and nothing outside the timeline’s folder is read."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” anger %2$@ utanför sin egen mapp:\n\n%3$@\n\nOm tidslinjen är din egen, eller om du litar på var den kommer ifrån, använd dem. Annars importerar du utan: de klippen utelämnas, och inget utanför tidslinjens mapp läses."
          }
        }
      }
    },
