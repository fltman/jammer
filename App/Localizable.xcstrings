        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela den här kanalen från en fil gjord genom dess pluginer, och låt pluginerna vila. Nivå, panorering, tystning och sends fungerar som vanligt."
          }
        }
      }
    },
    "mixer.frozen.track": {
      "comment": "Line under a frozen track.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen: plays from a file, its plugins rest. Unfreeze it to change its clips or plugins."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fryst: spelar från en fil, dess pluginer vilar. Tina den för att ändra dess klipp eller pluginer."
          }
        }
      }
    },
    "mixer.heard": {
      "comment": "Line under a strip in a VCA group. %1$@ the level heard, %2$@ the group, %3$@ the group’s own level.",
      "extractionState": "manual",
      "localizations": {
