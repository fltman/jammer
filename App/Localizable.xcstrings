              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld andra mappar"
                }
              }
            }
          }
        }
      }
    },
    "access.ask.text": {
      "comment": "Alert text. %1$@ the document, %2$@ “3 audio files”, %3$@ “1 other folder” or “2 other folders”, %4$@ the list of files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” wants to play %2$@ from %3$@ on this Mac:\n\n%4$@\n\nIf the project is your own, or you trust where it came from, use them. Otherwise open it without: those clips stay silent, and nothing outside the project is read."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” vill spela %2$@ från %3$@ på den här Macen:\n\n%4$@\n\nOm projektet är ditt eget, eller om du litar på var det kommer ifrån, använd dem. Annars öppnar du det utan: de klippen förblir tysta, och inget utanför projektet läses."
          }
        }
      }
    },
    "access.ask.title": {
      "comment": "Alert title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project uses audio from outside itself"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här projektet använder ljud utanför sig självt"
          }
        }
      }
    },
    "access.ask.use": {
      "comment": "Alert button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use These Files"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd filerna"
          }
        }
      }
    },
    "access.notAsDescribed": {
      "comment": "Status line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file isn’t the audio this project says it is and was left out."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files aren’t the audio this project says they are and were left out."
                }
              }
            }
          }
        },
        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fil är inte det ljud projektet säger att den är och utelämnades."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld filer är inte det ljud projektet säger att de är och utelämnades."
                }
              }
            }
          }
        }
      }
    },
    "access.notRead": {
      "comment": "Status line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file outside the project wasn’t read. Its clips are silent."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files outside the project weren’t read. Their clips are silent."
                }
              }
