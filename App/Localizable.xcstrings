      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@. Save them as a Jämmer project, keep them in Jämmer for later (File › Linked Files Waiting…), or discard them."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
