    "mixer.master.limiter.text": {
      "comment": "Explanation under the master’s limiter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limiter comes after everything else. An exported file is measured and held under the ceiling; playback has one pass and can go a little over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitern kommer efter allt annat. En exporterad fil mäts och hålls under taket; uppspelningen har ett pass och kan gå lite över."
          }
        }
      }
    },
    "mixer.mode.help": {
      "comment": "Help of the mode menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read: the fader is heard while you move it and set when you let go. Touch: while the sound plays, what you do with the fader is written as the strip’s level lane for as long as you hold it. Latch: it is written from when you take the fader until playback stops."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Read: fadern hörs medan du flyttar den och sätts när du släpper. Touch: medan ljudet spelar skrivs det du gör med fadern som kanalens nivåbana så länge du håller den. Latch: det skrivs från att du tar fadern tills uppspelningen stannar."
          }
        }
      }
    },
    "mixer.mode.label": {
      "comment": "Accessibility label of a strip’s Read/Touch/Latch menu. %@ is the strip.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the fader of %@ is taken while the sound plays"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur fadern för %@ tas medan ljudet spelar"
          }
        }
      }
    },
    "mixer.mode.latch": {
      "comment": "A strip’s mode: its level is written from when the fader is taken until playback stops.",
