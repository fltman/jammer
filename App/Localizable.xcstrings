    "mixer.ahead.stepped": {
      "comment": "Mixer window, after the engine stepped its distance up. %1$@ milliseconds, %2$@ is “3 dropouts”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac couldn’t keep the sound whole that close to the playhead with this document (%2$@), so a change here is now heard about %1$@ ms after it is made."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Macen kunde inte hålla ljudet helt så nära spelhuvudet med det här dokumentet (%2$@), så en ändring här hörs nu omkring %1$@ ms efter att den gjorts."
          }
        }
      }
    },
