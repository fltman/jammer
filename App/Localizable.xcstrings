    "limit.text.document": {
      "comment": "Alert text when nothing is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds the true peak of the document at or under the ceiling. All tracks get the same gain, so their balance stays. Where nothing needs limiting the audio is left exactly as it is, and one undo takes it back."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller dokumentets true peak på eller under taket. Alla spår får samma gain, så balansen behålls. Där inget behöver begränsas lämnas ljudet precis som det är, och ett ångrasteg tar tillbaka det."
          }
        }
      }
    },
    "limit.text.selection": {
      "comment": "Alert text when there is a selection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds the true peak of the selection at or under the ceiling. All tracks get the same gain, so their balance stays. Where nothing needs limiting the audio is left exactly as it is, and one undo takes it back."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller markeringens true peak på eller under taket. Alla spår får samma gain, så balansen behålls. Där inget behöver begränsas lämnas ljudet precis som det är, och ett ångrasteg tar tillbaka det."
          }
        }
      }
    },
