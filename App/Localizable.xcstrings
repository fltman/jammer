    "link.close.lost.text": {
      "comment": "%1$@ is why the file can’t be used (a whole sentence), %2$@ is “3 steps not saved back”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@. Save them as a Jämmer project, keep them in Jämmer for later (File › Linked Files Waiting…), or discard them."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@. Spara dem som ett Jämmer-projekt, behåll dem i Jämmer till senare (Arkiv › Länkade filer som väntar…) eller släng dem."
          }
        }
      }
    },
