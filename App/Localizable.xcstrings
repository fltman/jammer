        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fil utanför projektet lästes inte. Dess klipp är tysta."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld filer utanför projektet lästes inte. Deras klipp är tysta."
                }
              }
            }
          }
        }
      }
    },
    "access.using": {
      "comment": "Status line.",
      "extractionState": "manual",
      "localizations": {
