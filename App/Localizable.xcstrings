                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ljudfiler"
                }
              }
            }
          }
        }
      }
    },
    "access.ask.folders": {
      "comment": "Part of access.ask.text: from how many folders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
