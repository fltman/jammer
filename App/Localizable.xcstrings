    "overdub.ask.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text goes to ElevenLabs with your key. The new clip is marked as made with a cloned voice, in the document and in an exported WAV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten går till ElevenLabs med din nyckel. Det nya klippet märks som gjort med en klonad röst, i dokumentet och i en exporterad WAV."
          }
        }
      }
    },
    "overdub.ask.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says the text in the cloned voice and puts it in place of %1$@–%2$@ s; what follows moves with it. One undo step."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säger texten med den klonade rösten och lägger den i stället för %1$@–%2$@ s; det som följer flyttar med. Ett ångrasteg."
          }
        }
      }
    },
    "overdub.ask.title": {
      "extractionState": "manual",
      "localizations": {
