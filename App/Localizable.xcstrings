    "duck.text": {
      "comment": "Alert text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick the tracks to lower (music, atmosphere). They go down 12 dB while there is speech on the other tracks and come up in the pauses. Each ticked track gets a new file; Undo brings the old sound back."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryssa i spåren som ska sänkas (musik, atmosfär). De går ned 12 dB medan det finns tal på de andra spåren och kommer upp i pauserna. Varje ikryssat spår får en ny fil; Ångra tar tillbaka det gamla ljudet."
          }
        }
      }
    },
