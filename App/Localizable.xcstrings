      "comment": "Shown when no usable model is installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the models installed in Ollama can call tools, which the assistant needs."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av modellerna som är installerade i Ollama kan anropa verktyg, vilket assistenten behöver."
          }
        }
      }
    },
    "assistant.ollama.notEvaluated": {
      "comment": "A model in the menu. %@ is the model.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (not evaluated with Jämmer)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (inte utvärderad med Jämmer)"
          }
        }
      }
    },
    "assistant.ollama.text": {
      "comment": "Explanation under the Ollama choice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slower than the on-device model, and the model takes about 6 GB of memory while it runs. Tried with qwen3:8b on one Mac. Jämmer doesn’t download models; it uses the ones you have installed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Långsammare än modellen på enheten, och modellen tar omkring 6 GB minne medan den körs. Provad med qwen3:8b på en Mac. Jämmer laddar inte ned modeller; den använder dem du har installerat."
          }
        }
      }
    },
    "assistant.paid.rate": {
      "comment": "First sentence of the question before a paid request, when no estimate is known. %@ is the provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ account is charged at the model’s rate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt konto hos %@ debiteras enligt modellens pris."
          }
        }
      }
    },
    "assistant.paid.text": {
      "comment": "Alert text. %1$@ a sentence about the price, %2$@ the provider, %3$@ a note about the provider (its own English).",
      "extractionState": "manual",
