    "plugin.key.noMono": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a sidechain input, but it wouldn't take mono float audio on it."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har en sidechain-ingång, men den tar inte flyttalsljud i mono på den."
          }
        }
      }
    },
    "plugin.key.noStereo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a sidechain input, but it wouldn't take stereo float audio on it."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har en sidechain-ingång, men den tar inte flyttalsljud i stereo på den."
          }
        }
      }
    },
    "plugin.key.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no sidechain input, so it can't be given a key."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen sidechain-ingång, så den kan inte få en key."
          }
        }
      }
    },
    "plugin.key.outOfProcess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a sidechain input, but it runs in a process of its own here (Safe Mode, or because macOS wouldn't load it into Jämmer), and a key isn't carried there yet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har en sidechain-ingång, men den körs här i en egen process (säkert läge, eller för att macOS inte ville ladda den i Jämmer), och en key förs inte dit än."
          }
        }
      }
    },
    "plugin.key.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a sidechain input, but wouldn't let Jämmer feed it."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har en sidechain-ingång, men lät inte Jämmer mata den."
          }
        }
      }
    },
    "pluginSettings.ask.loadConfined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load in Separate Processes"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda i separata processer"
          }
        }
      }
    },
    "pluginSettings.ask.rowKind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@ (%2$@) on “%3$@”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@ (%2$@) på ”%3$@”"
          }
        }
      }
    },
    "pluginSettings.ask.textConfined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” brings saved settings for:\n\n%2$@\n\nSettings are data the plugin reads, and they weren’t made in this Jämmer. If you load them, each of these plugins runs in a process of its own, so a plugin that misreads them can’t take Jämmer down with it; that costs a little more of the computer. Otherwise open the project without them: those plugins aren’t started."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” har med sig sparade inställningar för:\n\n%2$@\n\nInställningar är data som pluginen läser, och de gjordes inte i den här Jämmer. Laddar du dem körs var och en av de här pluginerna i en egen process, så att en plugin som läser dem fel inte kan dra med sig Jämmer; det kostar lite mer av datorn. Annars öppnar du projektet utan dem: de pluginerna startas inte."
          }
        }
      }
    },
