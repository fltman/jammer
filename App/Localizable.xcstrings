      "comment": "Line under a muted strip in a VCA group. %1$@ a level, %2$@ the group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted; %1$@ with the group %2$@ when it isn’t"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tystad; %1$@ med gruppen %2$@ när den inte är det"
          }
        }
      }
    },
    "mixer.intro": {
      "comment": "Explanation at the top of the mixer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks go to the output, or to a bus that gathers several of them under one level. A document without buses, with every pan in the center, plays exactly as it always did."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spår går till utgången, eller till en buss som samlar flera under en nivå. Ett dokument utan bussar, med all panorering i mitten, spelar precis som det alltid har gjort."
          }
        }
      }
    },
    "mixer.level.ax": {
      "comment": "Spoken label. %@ is the strip.",
      "extractionState": "manual",
      "localizations": {
