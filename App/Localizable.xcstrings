              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld other folders"
                }
              }
            }
          }
        }
      }
    },
    "access.ask.text": {
      "comment": "Alert text. %1$@ the document, %2$@ “3 audio files”, %3$@ “another folder” or “2 other folders”, %4$@ the list of files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” wants to play %2$@ from %3$@ on this Mac:\n\n%4$@\n\nIf the project is your own, or you trust where it came from, use them. Otherwise open it without: those clips stay silent, and nothing outside the project is read."
          }
        }
      }
    },
    "access.ask.title": {
      "comment": "Alert title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project uses audio from outside itself"
          }
        }
      }
    },
    "access.ask.use": {
      "comment": "Alert button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use These Files"
