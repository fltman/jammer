    "assistant.intro": {
      "comment": "Shown in the empty assistant panel. Keep one Swedish and one English example.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask in Swedish or English, for example \"ta bort alla ehm och tystnader längre än en sekund\" or \"normalize to −16 LUFS\". Plans that remove audio are shown before they run, and everything is one undo step."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga på svenska eller engelska, till exempel ”ta bort alla ehm och tystnader längre än en sekund” eller ”normalize to −16 LUFS”. Planer som tar bort ljud visas innan de körs, och allt är ett enda ångrasteg."
          }
        }
      }
    },
    "assistant.key": {
      "comment": "Placeholder of the key field. %@ is the provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ key"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-nyckel"
          }
        }
      }
    },
    "assistant.key.saved": {
      "comment": "Placeholder of the key field when a key is saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key saved; type to replace"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeln är sparad; skriv för att byta"
          }
        }
      }
    },
    "assistant.key.text": {
      "comment": "Under the key field. %@ is a note about the provider (its own English).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ The key stays in your Keychain. Every request asks first and shows the price."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nyckeln stannar i din nyckelring. Varje förfrågan frågar först och visar priset."
          }
        }
      }
    },
    "assistant.list.needsKey": {
      "comment": "Note in the assistant’s settings. %@ is the provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
