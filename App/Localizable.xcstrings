    "acx.format.converted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoded here to measure it; export it the same way: MP3, %1$@ kbps, sample rate %2$@ kHz (the document is %3$@ kHz and is converted)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodad här för att mätas; exportera den på samma sätt: MP3, %1$@ kbit/s, samplingsfrekvens %2$@ kHz (dokumentet är %3$@ kHz och konverteras)."
          }
        }
      }
    },
    "acx.format.document": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the document is %@ kHz"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "dokumentet är %@ kHz"
          }
        }
      }
    },
    "acx.format.mp3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, %1$@ kbps constant bit rate, %2$@ kHz"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3, %1$@ kbit/s konstant bithastighet, %2$@ kHz"
          }
        }
      }
    },
    "acx.format.same": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoded here to measure it; export it the same way: MP3, %@ kbps."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodad här för att mätas; exportera den på samma sätt: MP3, %@ kbit/s."
          }
        }
      }
    },
    "acx.length": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ min %2$@ s"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ min %2$@ s"
          }
        }
      }
    },
    "acx.met": {
      "comment": "Start of a row in the ACX report.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ Met"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ Uppfyllt"
          }
        }
      }
    },
    "acx.narration.measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not something Jämmer measures"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "inget som Jämmer mäter"
          }
        }
      }
    },
    "acx.narration.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ACX also asks for one chapter or section per file with its header read out, separate opening and closing credits, and a retail sample of 5 minutes or less. See the article."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ACX vill också ha ett kapitel eller avsnitt per fil med rubriken uppläst, separata inlednings- och avslutningstexter och ett provavsnitt på högst 5 minuter. Se artikeln."
          }
        }
      }
    },
    "acx.noise.measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dB over %2$@ s of pauses"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dB över %2$@ s pauser"
          }
        }
      }
    },
    "acx.noise.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no pause found to measure it in"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ingen paus hittades att mäta det i"
          }
        }
      }
    },
    "acx.noise.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ACX doesn't say how the noise floor is measured. Here: the RMS of the quietest stretches between the speech (the pauses), on the mix."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ACX säger inte hur brusgolvet ska mätas. Här: RMS för de tystaste sträckorna mellan talet (pauserna), i mixen."
          }
        }
      }
    },
    "acx.none": {
      "comment": "Alert title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No measured requirement failed"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget uppmätt krav underkändes"
          }
        }
      }
    },
    "acx.notJudged": {
      "comment": "Start of a row in the ACX report.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "– Not judged"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Inte bedömt"
          }
        }
      }
    },
    "acx.notMet": {
      "comment": "Start of a row in the ACX report.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "✗ Not met"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "✗ Inte uppfyllt"
          }
        }
      }
    },
    "acx.on.mix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the mix before encoding (%@)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "mixen före kodning (%@)"
          }
        }
      }
    },
    "acx.on.mp3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the MP3 as it decodes"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3-filen som den avkodas"
          }
        }
      }
    },
    "acx.on.noReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no encoded file was measured"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ingen kodad fil mättes"
          }
        }
      }
    },
    "acx.on.notMade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the MP3 couldn't be made (%@)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3-filen kunde inte göras (%@)"
          }
        }
      }
    },
    "acx.on.unread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the MP3 couldn't be read back on this Mac"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MP3-filen kunde inte läsas tillbaka på den här Macen"
          }
        }
      }
    },
    "acx.peak.both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both are at or under −3."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda är på eller under −3."
          }
        }
      }
    },
    "acx.peak.measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sample peak %1$@, true peak %2$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "samplingstopp %1$@, true peak %2$@"
          }
        }
      }
    },
    "acx.peak.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ACX says \"peak\"; Jämmer asks both of the sample peak and of the true peak. On %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ACX säger ”peak”; Jämmer ställer kravet på både samplingstoppen och true peak. På %2$@."
          }
        }
      }
    },
    "acx.peak.sample": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sample peak is over −3."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samplingstoppen är över −3."
          }
        }
      }
    },
    "acx.peak.true": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sample peak passes; the true peak (between the samples) is over −3, and that decided it."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samplingstoppen klarar sig; true peak (mellan samplen) är över −3, och det avgjorde."
          }
        }
      }
    },
    "acx.rms.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ACX doesn't say how RMS is to be measured. Here: all samples of the whole file, both channels together, unweighted, relative to full scale; on %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ACX säger inte hur RMS ska mätas. Här: alla sampel i hela filen, båda kanalerna tillsammans, ovägt, i förhållande till full skala; på %@."
          }
        }
      }
    },
    "acx.roomTone.measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s at the start, %2$@ s at the end"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s i början, %2$@ s i slutet"
          }
        }
      }
    },
    "acx.roomTone.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured as the stretch at each end that stays under −45 dBFS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mätt som sträckan i varje ände som håller sig under −45 dBFS."
          }
        }
      }
    },
    "acx.roomTone.shortBoth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured as the stretch at each end that stays under −45 dBFS. Under the recommended 1 second at both ends."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mätt som sträckan i varje ände som håller sig under −45 dBFS. Under den rekommenderade 1 sekunden i båda ändarna."
          }
        }
      }
    },
    "acx.roomTone.shortEnd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured as the stretch at each end that stays under −45 dBFS. Under the recommended 1 second at the end."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mätt som sträckan i varje ände som håller sig under −45 dBFS. Under den rekommenderade 1 sekunden i slutet."
          }
        }
      }
    },
    "acx.roomTone.shortStart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured as the stretch at each end that stays under −45 dBFS. Under the recommended 1 second at the start."
