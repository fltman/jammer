{
  "sourceLanguage": "en",
  "strings": {
    "access.ask.files": {
      "comment": "Part of access.ask.text: how many files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld audio file"
