    "plugins.none.bus": {
      "comment": "Shown when a bus has no plugins. %@ is the bus.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plugins on the bus %@. Add one below; it runs on everything that goes through the bus, before the bus’s level. What it adds in delay is made up for across the mixer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga pluginer på bussen %@. Lägg till en nedan; den körs på allt som går genom bussen, före bussens nivå. Den fördröjning den lägger till kompenseras i hela mixern."
          }
        }
      }
    },
    "plugins.none.master": {
      "comment": "Shown when the master has no plugins.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plugins on the master. Add one below; it runs on the whole mix, before the master’s level and its limiter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga pluginer på mastern. Lägg till en nedan; den körs på hela mixen, före masterns nivå och dess limiter."
          }
        }
      }
    },
    "plugins.none.track": {
      "comment": "Shown when a track has no plugins. %@ is the track.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plugins on %@. Add one below; it runs after the clips and before the track’s gain."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga pluginer på %@. Lägg till en nedan; den körs efter klippen och före spårets gain."
          }
        }
      }
    },
