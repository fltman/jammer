    "pluginSettings.ask.load": {
      "comment": "Alert button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load Settings"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs in inställningar"
          }
        }
      }
    },
    "pluginSettings.ask.row": {
      "comment": "A row in the list of plugins a project brings settings for. %1$@ is the plugin, %2$@ the track or bus.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@ on “%2$@”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@ på ”%2$@”"
          }
        }
      }
    },
    "pluginSettings.ask.text": {
      "comment": "Alert text. %1$@ is the document, %2$@ the list of plugins.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” brings saved settings for:\n\n%2$@\n\nSettings are data the plugin reads, and they weren’t made in this Jämmer. If the project is your own, or you trust where it came from, load them. Otherwise open it without: those plugins aren’t started and their tracks play without them."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” har med sig sparade inställningar för:\n\n%2$@\n\nInställningar är data som pluginen läser, och de gjordes inte i den här Jämmer. Om projektet är ditt eget, eller om du litar på var det kommer ifrån, läs in dem. Annars öppnar du det utan: de pluginerna startas inte och deras spår spelar utan dem."
          }
        }
      }
    },
    "pluginSettings.ask.title.many": {
      "comment": "Alert title. %@ is how many plugins (two or more).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project wants to load settings into %@ plugins"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här projektet vill läsa in inställningar i %@ pluginer"
          }
        }
      }
    },
    "pluginSettings.ask.title.one": {
      "comment": "Alert title. %@ is the plugin’s name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project wants to load settings into %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här projektet vill läsa in inställningar i %@"
          }
        }
      }
    },
    "pluginSettings.loaded": {
