    "link.close.steps": {
      "comment": "How much work a linked document has that isn’t in the file yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld step not saved back"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld steps not saved back"
                }
              }
            }
          }
        },
        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld steg inte tillbakasparat"
