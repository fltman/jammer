    "plugins.about.ahead": {
      "comment": "Sentence added after the explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins play 0.3 s ahead, so a change is heard a moment later."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluginer spelar 0,3 s i förväg, så en ändring hörs ett ögonblick senare."
          }
        }
      }
    },
    "plugins.about.audioUnits": {
      "comment": "Explanation at the bottom of the plugins sheet (Audio Units only).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins are third-party code that runs inside Jämmer. If one crashes or misbehaves, turn on safe mode: every Audio Unit then runs in macOS’s separate plugin host process."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluginer är kod från tredje part som körs inuti Jämmer. Om en kraschar eller beter sig fel, slå på säkert läge: varje Audio Unit körs då i macOS separata process för pluginer."
          }
        }
      }
    },
    "plugins.about.hosted": {
      "comment": "Explanation at the bottom of the plugins sheet (builds with CLAP).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins are third-party code. CLAP plugins each run in a helper process of their own, never inside Jämmer. Audio Units run inside Jämmer; if one crashes or misbehaves, turn on safe mode: every Audio Unit then runs in macOS’s separate plugin host process."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluginer är kod från tredje part. CLAP-pluginer körs var och en i en egen hjälpprocess, aldrig inuti Jämmer. Audio Units körs inuti Jämmer; om en kraschar eller beter sig fel, slå på säkert läge: varje Audio Unit körs då i macOS separata process för pluginer."
          }
        }
      }
    },
    "plugins.add": {
      "comment": "Menu button.",
      "extractionState": "manual",
      "localizations": {
