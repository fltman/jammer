    "mixer.pan.automated.help": {
      "comment": "Why the pan slider is grey.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pan lane steers this strip’s pan, so the slider does nothing. Switch the lane off or clear it to pan by hand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En panoreringsbana styr den här kanalens panorering, så reglaget gör ingenting. Stäng av banan eller rensa den för att panorera för hand."
          }
        }
      }
    },
