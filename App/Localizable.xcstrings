    },
    "link.close.text": {
      "comment": "%1$@ is the app that handed the file over, %2$@ is “3 steps not saved back”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is waiting for this file. %2$@. Save Back writes them into the file. Keep for Later closes the window and keeps them in Jämmer (File › Linked Files Waiting…). Discard gives them up; the file stays as it was."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ väntar på den här filen. %2$@. Spara tillbaka skriver in dem i filen. Behåll till senare stänger fönstret och behåller dem i Jämmer (Arkiv › Länkade filer som väntar…). Släng ger upp dem; filen förblir som den var."
          }
        }
      }
    },
    "link.close.title": {
      "comment": "Closing a linked document with changes. %@ is the file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your changes back to “%@”?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du spara tillbaka dina ändringar till ”%@”?"
          }
        }
      }
    },
