          }
        }
      }
    },
    "error.automation.noSend": {
      "comment": "An error’s reason, shown in the status line after a step that failed (the agent API says the same in English). Placeholders are names, ids or numbers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
