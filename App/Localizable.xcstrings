        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins are third-party code that runs inside Jämmer. If one crashes or misbehaves, turn on safe mode: every Audio Unit then runs in macOS’s separate plugin host process."
          }
        }
      }
    },
    "plugins.about.hosted": {
      "comment": "Explanation at the bottom of the plugins sheet (builds with CLAP).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins are third-party code. CLAP plugins each run in a helper process of their own, never inside Jämmer. Audio Units run inside Jämmer; if one crashes or misbehaves, turn on safe mode: every Audio Unit then runs in macOS’s separate plugin host process."
          }
        }
      }
    },
