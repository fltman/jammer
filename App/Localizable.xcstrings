    "paid.elevenlabs.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own key from your own ElevenLabs account, kept in this Mac’s Keychain. Don’t share it: ElevenLabs’ terms tie a key to its account, and every request made with it is that account’s. Used only for Overdub, only when you send. Built from ElevenLabs’ documentation, not tried with a real request."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egen nyckel från ditt eget ElevenLabs-konto, sparad i den här Macens nyckelring. Dela den inte: enligt ElevenLabs villkor hör en nyckel till sitt konto, och varje anrop med den är det kontots. Används bara för Overdub, och bara när du skickar. Byggt efter ElevenLabs dokumentation, inte provat med ett riktigt anrop."
          }
        }
      }
    },
