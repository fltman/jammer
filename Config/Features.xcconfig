// Features a release can be built without, with no code change (docs/RELEASING.md,
// "Must be decided before release"). Debug builds always have them (Config/Debug.xcconfig).
// This file is the switch: the package manifest reads it too, so with NO the code isn't
// compiled into a release at all. Run scripts/export-agents-guide.sh after changing it.
//
// Reduce Reverb (WPE): the menu item, restore kind "dereverb", the assistant's hint and the
// guide follow this; the manual follows it through Config/site-features.json.
JAMMER_DEREVERB = YES

// Freeform areas in the spectrogram (lasso and brush; spectral_edit shapes polygon and brush).
// With NO only the box is offered; the code stays in the build. Menu, keys, API, guide and
// manual follow this.
JAMMER_SPECTRAL_FREEFORM = YES

// CLAP plugins, each in a helper process of its own. With NO the two helper programs aren't
// built into the app, nothing is scanned, and the guide, /operations, the Plugins sheet, the
// manual, the FAQ and the site mention only Audio Units. NO until two things are done
// (docs/RELEASING.md): the helpers' entitlement is approved, and a CLAP plugin from another
// vendor has worked in a signed build.
JAMMER_CLAP = NO
