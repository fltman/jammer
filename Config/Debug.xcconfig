// Debug builds have every feature, whatever Features.xcconfig says for releases.
JAMMER_DEREVERB = YES
JAMMER_SPECTRAL_FREEFORM = YES
JAMMER_FEATURE_CONDITIONS = $(JAMMER_DEREVERB_CONDITION_$(JAMMER_DEREVERB)) $(JAMMER_SPECTRAL_FREEFORM_CONDITION_$(JAMMER_SPECTRAL_FREEFORM))
JAMMER_DEREVERB_CONDITION_YES = JAMMER_DEREVERB
JAMMER_SPECTRAL_FREEFORM_CONDITION_YES = JAMMER_SPECTRAL_FREEFORM
